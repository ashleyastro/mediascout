# --- Demo mode: fictional data only, no crawling or email (for a public showcase)
DEMO_MODE=false

# --- Storage
MEDIASCOUT_DB=mediascout.db

# --- Public URL (used to show the Claude / ChatGPT connector URL)
PUBLIC_BASE_URL=https://mediascout.yourcompany.com

# --- Access control
# Password for the web UI and REST API (HTTP Basic; any username).
APP_PASSWORD=
# Puts the MCP endpoint at /mcp/<secret>. Use a long random string, e.g. `openssl rand -hex 24`.
MCP_SECRET=
# Comma-separated Host headers allowed on the MCP endpoint (e.g. mediascout.yourcompany.com). Empty = no check.
ALLOWED_HOSTS=

# --- Crawling
MEDIASCOUT_USER_AGENT=MediaScoutBot/1.0 (+https://yourcompany.com/bot; media research crawler)
RESPECT_ROBOTS=true
MAX_CONCURRENCY=32
PER_HOST_CONCURRENCY=2
PER_HOST_DELAY_MS=500
OUTLET_CONCURRENCY=12
MAX_CANDIDATES_PER_OUTLET=300
MAX_CHILD_SITEMAPS=120
PAGE_CACHE_DAYS=30

# --- Optional discovery providers
GDELT_ENABLED=true
NEWSAPI_KEY=

# --- Optional email-finder (used only when no email is published on the author's page)
HUNTER_API_KEY=

# --- Email export (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
